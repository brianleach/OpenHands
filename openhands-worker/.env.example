# OpenHands Worker Environment Variables
# Copy to .dev.vars for local development

# Linear OAuth Application
LINEAR_CLIENT_ID=your_linear_client_id
LINEAR_CLIENT_SECRET=your_linear_client_secret
LINEAR_WEBHOOK_SECRET=your_linear_webhook_secret

# Anthropic API (Claude)
ANTHROPIC_API_KEY=your_anthropic_api_key

# Optional: Override default LLM model
# LLM_MODEL=claude-sonnet-4-20250514

# GitHub
GH_TOKEN=your_github_personal_access_token
GIT_USER_NAME=OpenHands
GIT_USER_EMAIL=openhands@example.com

# Admin UI Protection (recommended)
GATEWAY_TOKEN=your_random_admin_token
